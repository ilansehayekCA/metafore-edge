{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metafore/mqtt/route_result",
  "title": "Route Execution Result",
  "description": "Published by Access Controller to telemetry/{tenant_id}/{controller_id}/route-results",
  "type": "object",
  "required": ["controller_id", "tenant_id", "route_id", "timestamp", "status"],
  "properties": {
    "controller_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "route_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["success", "error", "timeout", "rejected"] },
    "action": { "type": "string", "enum": ["query", "execute", "shell", "http"] },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "row_count": { "type": "integer", "minimum": 0 },
    "rows_affected": { "type": "integer", "minimum": 0 },
    "data": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Result rows for SELECT queries"
    },
    "http_status": { "type": "integer", "description": "HTTP status code for REST routes" },
    "response_body": { "description": "Response body for REST routes" },
    "error": { "type": "string" },
    "error_details": { "type": "string" }
  },
  "additionalProperties": false
}
